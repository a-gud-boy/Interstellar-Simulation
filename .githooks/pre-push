#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

ZERO_SHA="0000000000000000000000000000000000000000"
declare -A CHANGED_SIMS=()
SHARED_CHANGED=0
DESKTOP_CHANGED=0
WGSL_CHANGED=0
META_CHANGED=0

record_file() {
  local file="$1"
  if [[ "$file" =~ ^(sims/[a-z0-9-]+)/ ]]; then
    local sim="${BASH_REMATCH[1]}"
    if [[ -f "${sim}/tests/physics_check.mjs" ]]; then
      CHANGED_SIMS["$sim"]=1
    fi
  elif [[ "$file" =~ ^(shared|scripts)/ ]] || [[ "$file" == "index.html" ]]; then
    SHARED_CHANGED=1
  fi

  if [[ "$file" =~ \.wgsl(\.js)?$ ]] || [[ "$file" == "scripts/sync-wgsl.mjs" ]]; then
    WGSL_CHANGED=1
  fi

  if [[ "$file" == "shared/sims.json" ]] || [[ "$file" == "shared/simRegistry.js" ]] || [[ "$file" == "home/catalogData.js" ]] || [[ "$file" == "desktop/src/sims/registry.rs" ]] || [[ "$file" == "scripts/sync-metadata.mjs" ]]; then
    META_CHANGED=1
  fi

  if [[ "$file" =~ ^desktop/ ]] || [[ "$file" == "shared/assets/milkyway_4k.jpg" ]] || [[ "$file" == "shared/sims.json" ]] || [[ "$file" =~ ^shared/shaders/.*\.wgsl$ ]] || [[ "$file" =~ ^sims/[a-z0-9-]+/src/shaders/.*\.wgsl$ ]]; then
    DESKTOP_CHANGED=1
  fi
}

saw_stdin=0
if [[ ! -t 0 ]]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_ref:-}" ]] && continue
    saw_stdin=1

    # Skip branch deletions
    if [[ "$local_sha" == "$ZERO_SHA" ]]; then
      continue
    fi

    if [[ "$remote_sha" == "$ZERO_SHA" ]]; then
      # Newly pushed branch: extract actual changed file paths from commits not on any remote
      while IFS= read -r file; do
        [[ -n "$file" ]] && record_file "$file"
      done < <(git log --name-only --pretty=format: "$local_sha" --not --remotes)
    else
      while IFS= read -r file; do
        [[ -n "$file" ]] && record_file "$file"
      done < <(git diff --name-only "${remote_sha}..${local_sha}")
    fi
  done
fi

# Safe fallback for manual direct invocation without ref lines on stdin
if [[ "$saw_stdin" -eq 0 ]]; then
  if git rev-parse --verify --quiet HEAD~1 >/dev/null 2>&1; then
    while IFS= read -r file; do
      [[ -n "$file" ]] && record_file "$file"
    done < <(git diff --name-only HEAD~1..HEAD)
  elif git rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
    while IFS= read -r file; do
      [[ -n "$file" ]] && record_file "$file"
    done < <(git diff-tree --no-commit-id --name-only -r --root HEAD)
  fi
fi

if [[ "${#CHANGED_SIMS[@]}" -eq 0 && "$SHARED_CHANGED" -eq 0 && "$DESKTOP_CHANGED" -eq 0 && "$WGSL_CHANGED" -eq 0 && "$META_CHANGED" -eq 0 ]]; then
  exit 0
fi

failed=0
if [[ "$META_CHANGED" -eq 1 || "$SHARED_CHANGED" -eq 1 ]]; then
  echo "[pre-push] Running node scripts/sync-metadata.mjs --check ..."
  if ! node scripts/sync-metadata.mjs --check; then
    echo "[pre-push] FAILED: scripts/sync-metadata.mjs --check" >&2
    failed=1
  fi
fi
if [[ "$WGSL_CHANGED" -eq 1 || "$SHARED_CHANGED" -eq 1 ]]; then
  echo "[pre-push] Running node scripts/sync-wgsl.mjs --check ..."
  if ! node scripts/sync-wgsl.mjs --check; then
    echo "[pre-push] FAILED: scripts/sync-wgsl.mjs --check" >&2
    failed=1
  fi
fi
if [[ "$SHARED_CHANGED" -eq 1 ]]; then
  echo "[pre-push] Shared/root change detected — running node scripts/run-tests.mjs --physics ..."
  if ! node scripts/run-tests.mjs --physics; then
    echo "[pre-push] FAILED: scripts/run-tests.mjs --physics" >&2
    failed=1
  fi
fi

for sim in "${!CHANGED_SIMS[@]}"; do
  if [[ "$SHARED_CHANGED" -eq 0 ]]; then
    echo "[pre-push] Running node ${sim}/tests/physics_check.mjs ..."
    if ! node "${sim}/tests/physics_check.mjs"; then
      echo "[pre-push] FAILED: ${sim}/tests/physics_check.mjs" >&2
      failed=1
      continue
    fi
  fi

  if [[ "${RUN_BROWSER_QA:-0}" == "1" ]]; then
    echo "[pre-push] RUN_BROWSER_QA=1 enabled — running browser & Firefox QA for ${sim} ..."

    if [[ -z "${DISPLAY:-}" ]] || [[ ! -x /usr/bin/google-chrome ]] || ! command -v nvidia-smi >/dev/null 2>&1; then
      echo "[pre-push] ERROR: Missing prerequisites for ${sim}/tests/browser_qa.mjs (need DISPLAY, /usr/bin/google-chrome, nvidia-smi)" >&2
      failed=1
    elif ! node "${sim}/tests/browser_qa.mjs"; then
      echo "[pre-push] FAILED: ${sim}/tests/browser_qa.mjs" >&2
      failed=1
    fi

    if [[ -z "${WAYLAND_DISPLAY:-}" ]] || ! command -v firefox >/dev/null 2>&1 || ! command -v nvidia-smi >/dev/null 2>&1; then
      echo "[pre-push] ERROR: Missing prerequisites for ${sim}/tests/firefox_qa.mjs (need WAYLAND_DISPLAY, firefox, nvidia-smi)" >&2
      failed=1
    elif ! node "${sim}/tests/firefox_qa.mjs"; then
      echo "[pre-push] FAILED: ${sim}/tests/firefox_qa.mjs" >&2
      failed=1
    fi
  fi
done

if [[ "$DESKTOP_CHANGED" -eq 1 ]]; then
  if command -v cargo >/dev/null 2>&1; then
    echo "[pre-push] Running cargo test (desktop physics_parity & shader_validation) ..."
    if ! cargo test --manifest-path desktop/Cargo.toml --test physics_parity --test shader_validation; then
      echo "[pre-push] FAILED: desktop cargo tests" >&2
      failed=1
    fi
  else
    echo "[pre-push] Note: cargo not found in PATH, skipping desktop cargo tests." >&2
  fi
fi

exit "$failed"
