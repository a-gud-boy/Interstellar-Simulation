{
  "physics-check-on-edit": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post_edit_physics_check.mjs",
            "timeout": 45
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/post_edit_physics_check.mjs",
        "timeout": 10
      }
    ]
  }
}
